# Copia este archivo como .env y ajusta los valores segun tu entorno.

# Ruta de la base de datos SQLite (relativa a la raiz del proyecto).
DATABASE_URL="file:./prisma/dev.db"

# Tamano maximo permitido por archivo PDF subido (credencial/solicitud), en megabytes.
MAX_PDF_SIZE_MB=5

# Solo para produccion (node build/index.js): @sveltejs/adapter-node rechaza
# peticiones mayores a este tamano ANTES de que la app las vea (por defecto
# 512K, insuficiente para subir 2 PDF). Debe ser mayor a 2 * MAX_PDF_SIZE_MB
# + margen; ajustalo si cambias MAX_PDF_SIZE_MB. No aplica a `pnpm run dev`.
BODY_SIZE_LIMIT=15M

# Clave para firmar las cookies de sesion del administrador (minimo 32 caracteres).
# Genera una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplaza-este-valor-con-uno-generado-de-al-menos-32-caracteres"

# Solo para produccion (node build/index.js): @sveltejs/adapter-node necesita
# conocer su propio origen para la proteccion CSRF integrada de SvelteKit.
# No se usa en desarrollo (pnpm run dev la infiere sola). Ejemplo:
# ORIGIN="https://ampliacion.azc.uam.mx"
